---
import { toTagSlug } from "../../lib/content";
import Anchor from "./Anchor.astro";

type Props = {
  tags: string[];
  linked?: boolean;
  label?: string;
};

const { tags, linked = true, label = "文章标签" } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-2" aria-label={label}>
      {tags.map((tag) => (
        <li>
          {linked ? (
            <Anchor
              url={`/tags/${toTagSlug(tag)}`}
              class="tag-link text-xs"
              plain
            >
              #{tag}
            </Anchor>
          ) : (
            <span class="tag-link text-xs">#{tag}</span>
          )}
        </li>
      ))}
    </ul>
  )
}
