---
export type Props = {
	url: string;
	class?: string;
	external?: boolean;
	showExternalIcon?: boolean;
	current?: boolean;
	plain?: boolean;
	"aria-label"?: string;
};

const {
  url,
  external = false,
  showExternalIcon = true,
  current = false,
  plain = false,
  class: className,
} = Astro.props;
---

<a
  href={url}
  class:list={[
    "zag-offset font-medium inline-flex items-center focus:outline-2 focus:outline-offset-2 focus:outline-zag-dark dark:focus:outline-zag-light",
    !plain && "underline",
    className,
  ]}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  aria-label={Astro.props["aria-label"]}
  aria-current={current ? "page" : undefined}
>
  <slot />
  {
    external && showExternalIcon ? (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="ms-1 h-4 w-4"
        viewBox="0 0 512 512"
        aria-hidden="true"
      >
        <path
          class="zag-fill zag-transition"
          fill-rule="evenodd"
          d="M362.666 149.333V320H320l-.001-97.831l-154.51 154.51l-30.169-30.17L289.829 192h-97.83v-42.666z"
        />
      </svg>
    ) : null
  }
</a>
