---
import Anchor from "./common/Anchor.astro";
import TagList from "./common/TagList.astro";

export type Props = {
  title: string;
  description: string;
  url: string;
  githubUrl?: string;
  liveUrl?: string;
  tags: string[];
  draft?: boolean;
  headingLevel?: "h2" | "h3";
};

const {
  title,
  description,
  url,
  githubUrl,
  liveUrl,
  tags,
  draft = false,
  headingLevel = "h2",
} = Astro.props;
const Heading = headingLevel;
---

<article class="content-snippet relative flex flex-col gap-4 hover-zag-dotted-grid">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex flex-wrap items-center gap-3">
      <Heading>
        <Anchor url={url} class="snippet-title text-xl leading-8 sm:text-2xl" plain>
          {title}
        </Anchor>
      </Heading>
      {draft && <span class="draft-badge">草稿预览</span>}
    </div>
    {
      (githubUrl || liveUrl) && (
        <div class="flex shrink-0 flex-wrap gap-4 text-sm">
          {githubUrl && (
            <Anchor url={githubUrl} external>
              GitHub
            </Anchor>
          )}
          {liveUrl && (
            <Anchor url={liveUrl} external>
              演示
            </Anchor>
          )}
        </div>
      )
    }
  </div>
  <p class="max-w-prose leading-7 zag-muted">{description}</p>
  <TagList tags={tags} linked={false} label="项目标签" />
</article>
