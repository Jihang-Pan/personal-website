---
import { getConfigurationCollection, processArticleDate } from "../lib/utils";
import Anchor from "./common/Anchor.astro";
import TagList from "./common/TagList.astro";

export type Props = {
  title: string;
  description: string;
  url: string;
  duration?: number;
  timestamp?: Date;
  tags?: string[];
  draft?: boolean;
  headingLevel?: "h2" | "h3";
};

const {
  title,
  description,
  url,
  duration,
  timestamp,
  tags = [],
  draft = false,
  headingLevel = "h2",
} = Astro.props;
const { data: config } = await getConfigurationCollection();
const Heading = headingLevel;
---

<article class="content-snippet relative flex flex-col gap-4 hover-zag-dotted-grid">
  <div class="flex flex-wrap items-center gap-3">
    <Heading>
      <Anchor url={url} class="snippet-title text-xl leading-8 sm:text-2xl" plain>
        {title}
      </Anchor>
    </Heading>
    {draft && <span class="draft-badge">草稿预览</span>}
  </div>
  <p class="max-w-prose leading-7 zag-muted">{description}</p>
  <TagList tags={tags} />
  {
    (timestamp || duration) && (
      <div class="flex flex-wrap justify-between gap-3 text-sm zag-muted">
        {timestamp && (
          <time datetime={timestamp.toISOString()}>
            {processArticleDate(timestamp, config.site.locale)}
          </time>
        )}
        {duration && (
          <span>
            {duration} {config.texts.minutesToRead}
          </span>
        )}
      </div>
    )
  }
</article>
