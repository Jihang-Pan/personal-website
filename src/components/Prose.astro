---
type Props = { class?: string };

const { class: customClass } = Astro.props;
---

<div
  class:list={[
    "article-prose prose max-w-none font-serif prose-headings:font-mono prose-headings:text-zag-dark prose-headings:dark:text-zag-light prose-h2:mt-14 prose-h2:mb-5 prose-h2:text-2xl prose-h2:leading-snug prose-h3:mt-10 prose-h3:mb-4 prose-h3:text-xl prose-h3:leading-snug prose-p:my-6 prose-p:text-left prose-p:text-zag-dark prose-p:dark:text-zag-light prose-p:leading-8 prose-li:text-zag-dark prose-li:dark:text-zag-light prose-li:leading-8 prose-strong:text-zag-dark prose-strong:dark:text-zag-light prose-a:text-zag-dark prose-a:dark:text-zag-light prose-a:underline-offset-4 prose-code:font-mono prose-code:text-zag-dark prose-code:dark:text-zag-light prose-pre:font-mono prose-img:rounded-none",
    customClass,
  ]}
>
  <slot />
</div>
