---
import { getConfigurationCollection } from "../lib/utils";
import Anchor from "./common/Anchor.astro";
import Section from "./common/Section.astro";

const { data: config } = await getConfigurationCollection();
const year = new Date().getFullYear();
---

<footer class="site-footer mt-auto">
  <Section wide>
    <div class="footer-main-grid">
      <div class="footer-identity">
        <div class="footer-brand-row">
          <div class="brand-mark" aria-hidden="true">
            {config.personal.initials}
          </div>
          <p class="font-display text-base leading-loose sm:text-xl">
            {config.personal.name}
          </p>
        </div>
        <p class="mt-5 text-base leading-7">
          {config.personal.role}，生活在上海。
        </p>
        <p class="mt-1 max-w-lg text-base leading-7">
          写下思考与日常，也记录项目与旅途。
        </p>
        {
          config.personal.email && (
            <p class="mt-4 text-sm">
              <Anchor url={`mailto:${config.personal.email}`}>
                {config.personal.email}
              </Anchor>
            </p>
          )
        }
      </div>
      <nav class="footer-column" aria-label="页脚导航">
        <p class="footer-heading">EXPLORE</p>
        <ul class="footer-menu-grid">
          {
            config.menu.map((item) => (
              <li><Anchor url={item.url}>{item.label}</Anchor></li>
            ))
          }
        </ul>
      </nav>
      <div class="footer-column">
        <p class="footer-heading">CONNECT</p>
        <ul class="footer-connect-list">
          {
            config.personal.githubProfile && (
              <li>
                <Anchor url={config.personal.githubProfile} external>
                  GitHub
                </Anchor>
              </li>
            )
          }
          <li><Anchor url="/rss.xml">RSS</Anchor></li>
          <li class="zag-muted">{config.personal.location}</li>
        </ul>
      </div>
    </div>
    <div class="footer-legal flex flex-col gap-2 text-sm zag-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {config.personal.name}</p>
      <p>内容与代码，持续更新。</p>
    </div>
  </Section>
</footer>
