---
import type { ArticleFrontmatter } from "../../lib/types";
import { getConfigurationCollection } from "../../lib/utils";
import ArticleSnippet from "../ArticleSnippet.astro";
import Anchor from "../common/Anchor.astro";

type Props = {
  featuredArticles: Array<ArticleFrontmatter>;
  headingLevel?: "h2" | "h3";
};

const { featuredArticles, headingLevel = "h2" } = Astro.props;
const { data: config } = await getConfigurationCollection();
const Heading = headingLevel;
---

<section aria-labelledby="featured-articles-heading">
  <div class="flex items-baseline justify-between gap-4">
    <Heading
      id="featured-articles-heading"
      class="section-tab"
    >
      {config.texts.articlesName}
    </Heading>
    <Anchor url="/blog" class="text-sm">{config.texts.viewAll}</Anchor>
  </div>
  {
    featuredArticles.length > 0 ? (
      <ol class="mt-8 space-y-10">
        {featuredArticles.map((article) => (
          <li>
            <ArticleSnippet
              title={article.title}
              description={article.description}
              url={article.url}
              timestamp={article.timestamp}
              duration={article.readTime}
              tags={article.tags}
              draft={article.draft}
              headingLevel="h3"
            />
          </li>
        ))}
      </ol>
    ) : (
      <div class="empty-state mt-8" role="status">
        <p class="font-display text-xs leading-loose">NO POSTS YET</p>
        <p class="mt-3 leading-7">{config.texts.noArticles}</p>
      </div>
    )
  }
</section>
