---
import type { ProjectFrontmatter } from "../../lib/types";
import { getConfigurationCollection } from "../../lib/utils";
import Anchor from "../common/Anchor.astro";
import ProjectSnippet from "../ProjectSnippet.astro";

type Props = { featuredProjects: Array<ProjectFrontmatter> };

const { featuredProjects } = Astro.props;
const { data: config } = await getConfigurationCollection();
---

<section aria-labelledby="featured-projects-heading">
  <div class="flex items-baseline justify-between gap-4">
    <h2
      id="featured-projects-heading"
      class="section-tab"
    >
      {config.texts.projectsName}
    </h2>
    <Anchor url="/projects" class="text-sm">{config.texts.viewAll}</Anchor>
  </div>
  {
    featuredProjects.length > 0 ? (
      <ol class="mt-8 space-y-10">
        {featuredProjects.map((project) => (
          <li>
            <ProjectSnippet
              title={project.title}
              description={project.description}
              url={project.url}
              githubUrl={project.githubUrl}
              liveUrl={project.liveDemoUrl}
              tags={project.tags}
              draft={project.draft}
              headingLevel="h3"
            />
          </li>
        ))}
      </ol>
    ) : (
      <div class="empty-state mt-8" role="status">
        <p class="font-display text-xs leading-loose">NO PROJECTS YET</p>
        <p class="mt-3 leading-7">{config.texts.noProjects}</p>
      </div>
    )
  }
</section>
