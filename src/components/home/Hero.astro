---
import { getConfigurationCollection } from "../../lib/utils";
import Anchor from "../common/Anchor.astro";

const { data: config } = await getConfigurationCollection();
---

<div id="about" class="hero-grid">
  <div class="hero-copy min-w-0">
    <h1 class="hero-title font-display">
      {config.hero.title}
    </h1>
    <div class="hero-identity">
      <div class="hero-avatar">
        {
          config.hero.image ? (
            <img
              src={config.hero.image}
              alt={`${config.personal.name} 的头像`}
              width="72"
              height="72"
              fetchpriority="high"
            />
          ) : (
            <span class="hero-monogram" aria-hidden="true">
              {config.personal.initials}
            </span>
          )
        }
      </div>
      <p class="hero-role">{config.hero.subtitle}</p>
    </div>
    <p class="hero-description font-body">
      {config.hero.description}
    </p>
    <div class="hero-actions">
      <Anchor
        url={config.hero.primaryCtaUrl}
        class="button-link button-link-primary"
        plain
      >
        <span>{config.hero.primaryCtaText}</span>
        <span class="button-link-arrow" aria-hidden="true">→</span>
      </Anchor>
      <Anchor
        url={config.hero.secondaryCtaUrl}
        class="button-link button-link-secondary"
        plain
      >
        <span>{config.hero.secondaryCtaText}</span>
        <span class="button-link-arrow" aria-hidden="true">→</span>
      </Anchor>
    </div>
  </div>
  <figure class="hero-city" aria-label="上海城市天际线像素插画">
    <img
      class="hero-city-art"
      src="/shanghai-skyline.png"
      alt="上海城市天际线、东方明珠与渡轮的像素插画"
      width="1653"
      height="951"
      fetchpriority="high"
    />
  </figure>
</div>
<div class="hero-divider" aria-hidden="true"><span></span></div>
