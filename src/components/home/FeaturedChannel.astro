---
import type { ArticleFrontmatter } from "../../lib/types";
import ArticleSnippet from "../ArticleSnippet.astro";
import Anchor from "../common/Anchor.astro";

type Props = {
  id: string;
  title: string;
  url: string;
  articles: Array<ArticleFrontmatter>;
  emptyKicker: string;
  emptyMessage: string;
  headingLevel?: "h2" | "h3";
};

const {
  id,
  title,
  url,
  articles,
  emptyKicker,
  emptyMessage,
  headingLevel = "h2",
} = Astro.props;
const Heading = headingLevel;
---

<section aria-labelledby={id}>
  <div class="flex items-baseline justify-between gap-4">
    <Heading id={id} class="section-tab">{title}</Heading>
    <Anchor url={url} class="text-sm">查看全部</Anchor>
  </div>
  {
    articles.length > 0 ? (
      <ol class="mt-8 space-y-8">
        {articles.map((article) => (
          <li>
            <ArticleSnippet
              title={article.title}
              description={article.description}
              url={article.url}
              timestamp={article.timestamp}
              duration={article.readTime}
              tags={article.tags}
              draft={article.draft}
              headingLevel="h3"
            />
          </li>
        ))}
      </ol>
    ) : (
      <div class="channel-empty" role="status">
        <span class="channel-empty-mark" aria-hidden="true" />
        <div>
          <p class="font-display text-xs leading-loose zag-muted">{emptyKicker}</p>
          <p class="mt-3 text-lg leading-8">{emptyMessage}</p>
        </div>
      </div>
    )
  }
</section>
