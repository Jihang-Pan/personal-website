---
import { getConfigurationCollection } from "../lib/utils";
import Anchor from "./common/Anchor.astro";
import ThemeToggle from "./ThemeToggle.astro";

const { data: config } = await getConfigurationCollection();
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (url: string) => {
  const normalized = url.replace(/\/$/, "") || "/";
  return normalized === "/"
    ? pathname === normalized
    : pathname === normalized || pathname.startsWith(`${normalized}/`);
};
---

<header
  class="site-header zag-bg zag-border-b zag-transition sticky top-0 z-20 w-full"
  data-site-header
>
  <div class="site-shell mx-auto flex min-h-16 flex-wrap items-center justify-between gap-3 px-4 sm:flex-nowrap sm:px-6">
    <Anchor
      url="/"
      class="brand-link min-h-11 gap-3 no-underline"
      aria-label={`${config.personal.name} 首页`}
      plain
    >
      <span class="brand-mark" aria-hidden="true">{config.personal.initials}</span>
    </Anchor>

    <div class="flex items-center gap-2 sm:order-3">
      {
        config.personal.githubProfile && (
          <Anchor
            url={config.personal.githubProfile}
            class="icon-link h-11 w-11 justify-center"
            aria-label={`${config.personal.name} 的 GitHub`}
            external
            showExternalIcon={false}
            plain
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                class="zag-fill zag-transition"
                d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
              />
            </svg>
          </Anchor>
        )
      }
      <ThemeToggle />
      <button
        class="menu-toggle icon-link flex h-11 w-11 items-center justify-center sm:hidden"
        type="button"
        aria-label="打开导航菜单"
        aria-expanded="false"
        aria-controls="site-navigation"
      >
        <span class="menu-glyph" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
    </div>

    <nav
      id="site-navigation"
      class="site-nav order-3 w-full pb-4 sm:order-2 sm:w-auto sm:pb-0"
      data-open="false"
      aria-label="主导航"
    >
      <ul class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-1">
        {
          config.menu.map((item) => (
            <li>
              <Anchor
                url={item.url}
                class="nav-link min-h-11 px-3 py-2 no-underline"
                current={isCurrent(item.url)}
                plain
              >
                {item.label}
              </Anchor>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const button = header?.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = header?.querySelector<HTMLElement>(".site-nav");
  const mobileQuery = window.matchMedia("(max-width: 639px)");

  const setOpen = (open: boolean) => {
    if (!button || !nav) return;
    nav.dataset.open = String(open);
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "关闭导航菜单" : "打开导航菜单");
    nav.inert = mobileQuery.matches && !open;
  };

  const syncForViewport = () => {
    if (!nav) return;
    if (mobileQuery.matches) {
      setOpen(nav.dataset.open === "true");
    } else {
      nav.inert = false;
    }
  };

  button?.addEventListener("click", () => {
    setOpen(nav?.dataset.open !== "true");
  });

  nav?.addEventListener("click", (event) => {
    if (event.target instanceof HTMLAnchorElement && mobileQuery.matches) {
      setOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && nav?.dataset.open === "true") {
      setOpen(false);
      button?.focus();
    }
  });

  mobileQuery.addEventListener("change", syncForViewport);
  syncForViewport();
</script>
