---
import SEO from "../components/SEO.astro";
import Anchor from "../components/common/Anchor.astro";
import Section from "../components/common/Section.astro";
import Layout from "../layouts/Layout.astro";
import { getConfigurationCollection } from "../lib/utils";

const { data: config } = await getConfigurationCollection();
---

<Layout>
  <Fragment slot="head">
    <SEO
      title={config.notFoundMeta.title}
      description={config.notFoundMeta.description}
      canonicalPath="/404"
    />
    <meta name="robots" content="noindex" />
  </Fragment>
  <Section class="py-16 sm:py-24">
    <h1 class="font-display text-3xl leading-relaxed sm:text-5xl sm:leading-relaxed">
      404 / 页面走丢了
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-8 zag-muted">
      {config.notFoundMeta.description}
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Anchor url="/" class="button-link button-link-primary" plain>
        返回首页
      </Anchor>
      <Anchor url="/blog" class="button-link button-link-secondary" plain>
        浏览文章
      </Anchor>
    </div>
  </Section>
</Layout>
