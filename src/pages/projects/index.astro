---
import ProjectSnippet from "../../components/ProjectSnippet.astro";
import SEO from "../../components/SEO.astro";
import PageHeader from "../../components/common/PageHeader.astro";
import Section from "../../components/common/Section.astro";
import Layout from "../../layouts/Layout.astro";
import { getPublishedProjects } from "../../lib/content";
import { getConfigurationCollection } from "../../lib/utils";

const projects = await getPublishedProjects();
const { data: config } = await getConfigurationCollection();
---

<Layout>
  <Fragment slot="head">
    <SEO
      title={config.projectMeta.title}
      description={config.projectMeta.longDescription ?? config.projectMeta.description}
      canonicalPath="/projects"
      image={config.projectMeta.cardImage}
      tags={config.projectMeta.keywords}
    />
  </Fragment>
  <Section class="pb-16">
    <PageHeader
      title={config.texts.projectsName}
      description={config.projectMeta.longDescription}
    />
    {
      projects.length > 0 ? (
        <ol class="divide-y-2 divide-zag-dark dark:divide-zag-light">
          {projects.map((project) => (
            <li class="py-8 first:pt-10">
              <ProjectSnippet
                title={project.data.title}
                description={project.data.description}
                url={`/projects/${project.data.slug}`}
                githubUrl={project.data.githubUrl}
                liveUrl={project.data.liveDemoUrl}
                tags={project.data.tags}
                draft={project.data.draft}
              />
            </li>
          ))}
        </ol>
      ) : (
        <div class="empty-state my-10" role="status">
          <p class="font-display text-sm leading-loose">NO PROJECTS YET</p>
          <p class="mt-4 text-lg">{config.texts.noProjects}</p>
        </div>
      )
    }
  </Section>
</Layout>
