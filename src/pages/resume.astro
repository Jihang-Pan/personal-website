---
import Anchor from "../components/common/Anchor.astro";
import PageHeader from "../components/common/PageHeader.astro";
import Section from "../components/common/Section.astro";
import ProfileNav from "../components/ProfileNav.astro";
import SEO from "../components/SEO.astro";
import Layout from "../layouts/Layout.astro";
import { getPublishedProjects } from "../lib/content";
import { getConfigurationCollection } from "../lib/utils";

const { data: config } = await getConfigurationCollection();
const projects = (await getPublishedProjects()).slice(0, 3);
const hasDetails =
  config.resume.skills.length > 0 ||
  config.resume.experiences.length > 0 ||
  config.resume.education.length > 0;
---

<Layout>
  <Fragment slot="head">
    <SEO
      title={config.resumeMeta.title}
      description={config.resumeMeta.longDescription ?? config.resumeMeta.description}
      canonicalPath="/resume"
      image={config.resumeMeta.cardImage}
      tags={config.resumeMeta.keywords}
    />
  </Fragment>
  <Section wide class="resume-page pb-16 sm:pb-24">
    <PageHeader title="简历" description={config.resumeMeta.longDescription} />
    <ProfileNav />

    <div class="resume-hero">
      <div>
        {config.resume.status && <p class="profile-status w-fit">{config.resume.status}</p>}
        <h2>{config.personal.name}</h2>
        <p class="resume-targets">
          {config.resume.targetRoles.length > 0
            ? config.resume.targetRoles.join(" / ")
            : config.personal.role}
        </p>
        <p class="resume-summary">{config.resume.summary}</p>
        {config.resume.availability && (
          <p class="mt-4 zag-muted">{config.resume.availability}</p>
        )}
      </div>
      <dl class="resume-contact">
        <div>
          <dt>所在地</dt>
          <dd>{config.personal.location}</dd>
        </div>
        {config.personal.email && (
          <div>
            <dt>邮箱</dt>
            <dd><Anchor url={`mailto:${config.personal.email}`}>{config.personal.email}</Anchor></dd>
          </div>
        )}
        {config.personal.githubProfile && (
          <div>
            <dt>GitHub</dt>
            <dd><Anchor url={config.personal.githubProfile} external>个人主页</Anchor></dd>
          </div>
        )}
      </dl>
    </div>

    <div class="resume-actions print-hidden">
      {config.resume.downloadUrl && (
        <Anchor
          url={config.resume.downloadUrl}
          external={!config.resume.downloadUrl.startsWith("/")}
          class="button-link button-link-primary"
          plain
        >
          下载 PDF 简历
        </Anchor>
      )}
      <button class="button-link button-link-secondary" type="button" data-print-resume>
        打印 / 保存为 PDF
      </button>
    </div>

    {
      hasDetails && (
        <div class="resume-sections">
          {config.resume.skills.length > 0 && (
            <section class="resume-section">
              <h2>技能</h2>
              <div class="resume-skill-grid">
                {config.resume.skills.map((group) => (
                  <div>
                    <h3>{group.title}</h3>
                    <p>{group.items.join(" / ")}</p>
                  </div>
                ))}
              </div>
            </section>
          )}

          {config.resume.experiences.length > 0 && (
            <section class="resume-section">
              <h2>工作经历</h2>
              <ol class="resume-timeline">
                {config.resume.experiences.map((experience) => (
                  <li>
                    <div class="resume-entry-heading">
                      <div>
                        <h3>{experience.role}</h3>
                        <p>{experience.organization}{experience.location && ` · ${experience.location}`}</p>
                      </div>
                      <p>{experience.start} — {experience.end}</p>
                    </div>
                    {experience.description && <p class="resume-entry-copy">{experience.description}</p>}
                    {experience.highlights.length > 0 && (
                      <ul class="resume-highlights">
                        {experience.highlights.map((highlight) => <li>{highlight}</li>)}
                      </ul>
                    )}
                  </li>
                ))}
              </ol>
            </section>
          )}

          {config.resume.education.length > 0 && (
            <section class="resume-section">
              <h2>教育经历</h2>
              <ol class="resume-timeline">
                {config.resume.education.map((education) => (
                  <li>
                    <div class="resume-entry-heading">
                      <div>
                        <h3>{education.degree}</h3>
                        <p>{education.institution}</p>
                      </div>
                      {(education.start || education.end) && (
                        <p>{education.start}{education.start && education.end && " — "}{education.end}</p>
                      )}
                    </div>
                    {education.description && <p class="resume-entry-copy">{education.description}</p>}
                  </li>
                ))}
              </ol>
            </section>
          )}
        </div>
      )
    }

    <section class="resume-section resume-more">
      <h2>项目与写作</h2>
      <p>项目记录展示我如何把想法落到具体实现，文章则保留过程中的判断与细节。</p>
      {projects.length > 0 && (
        <ul>
          {projects.map((project) => (
            <li><Anchor url={`/projects/${project.data.slug}`}>{project.data.title}</Anchor></li>
          ))}
        </ul>
      )}
      <div class="resume-more-links print-hidden">
        <Anchor url="/projects">查看项目</Anchor>
        <Anchor url="/blog">阅读文章</Anchor>
      </div>
    </section>
  </Section>
</Layout>

<script>
  document.querySelector("[data-print-resume]")?.addEventListener("click", () => {
    window.print();
  });
</script>
