---
import ArticleSnippet from "../../components/ArticleSnippet.astro";
import Anchor from "../../components/common/Anchor.astro";
import PageHeader from "../../components/common/PageHeader.astro";
import Section from "../../components/common/Section.astro";
import SEO from "../../components/SEO.astro";
import Layout from "../../layouts/Layout.astro";
import { getPublishedArticles } from "../../lib/content";
import { getConfigurationCollection } from "../../lib/utils";

const articles = await getPublishedArticles();
const { data: config } = await getConfigurationCollection();
---

<Layout>
  <Fragment slot="head">
    <SEO
      title={config.blogMeta.title}
      description={config.blogMeta.longDescription ?? config.blogMeta.description}
      canonicalPath="/blog"
      image={config.blogMeta.cardImage}
      tags={config.blogMeta.keywords}
    />
  </Fragment>
  <Section class="pb-16">
    <PageHeader
      title={config.texts.articlesName}
      description={config.blogMeta.longDescription}
    />
    <nav class="flex flex-wrap gap-x-6 gap-y-3 py-6" aria-label="文章浏览方式">
      <Anchor url="/daily">日常</Anchor>
      <Anchor url="/travel">旅游</Anchor>
      <Anchor url="/archive">按时间归档</Anchor>
      <Anchor url="/tags">按标签浏览</Anchor>
      <Anchor url="/rss.xml">订阅 RSS</Anchor>
    </nav>
    {
      articles.length > 0 ? (
        <ol class="divide-y-2 divide-zag-dark dark:divide-zag-light">
          {articles.map((article) => (
            <li class="py-8 first:pt-4">
              <ArticleSnippet
                title={article.data.title}
                description={article.data.description}
                duration={article.data.readTime}
                url={`/blog/${article.data.slug}`}
                timestamp={article.data.timestamp}
                tags={article.data.tags}
                draft={article.data.draft}
              />
            </li>
          ))}
        </ol>
      ) : (
        <div class="empty-state my-10" role="status">
          <p class="font-display text-sm leading-loose">NO POSTS YET</p>
          <p class="mt-4 text-lg">{config.texts.noArticles}</p>
        </div>
      )
    }
  </Section>
</Layout>
