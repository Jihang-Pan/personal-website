---
import { render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import {
  getPublishedArticles,
  getRelatedArticles,
} from "../../lib/content";
import { getConfigurationCollection } from "../../lib/utils";

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  const { data: config } = await getConfigurationCollection();

  return Promise.all(
    articles.map(async (article, index) => ({
      params: { id: article.data.slug },
      props: {
        article: {
          ...article,
          data: {
            ...article.data,
            url: new URL(
              `/blog/${article.data.slug}`,
              config.site.baseUrl,
            ).toString(),
          },
        },
        previous: articles[index + 1]?.data,
        next: articles[index - 1]?.data,
        related: (await getRelatedArticles(
          article.data.slug,
          article.data.tags,
        )).map((entry) => entry.data),
      },
    })),
  );
}

const { article, previous, next, related } = Astro.props;
const { Content, headings } = await render(article);
---

<BlogLayout
  frontmatter={article.data}
  previous={previous}
  next={next}
  related={related}
  headings={headings}
>
  <Content />
</BlogLayout>
