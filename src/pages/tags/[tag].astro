---
import ArticleSnippet from "../../components/ArticleSnippet.astro";
import SEO from "../../components/SEO.astro";
import Anchor from "../../components/common/Anchor.astro";
import PageHeader from "../../components/common/PageHeader.astro";
import Section from "../../components/common/Section.astro";
import Layout from "../../layouts/Layout.astro";
import {
  getArticleTags,
  getPublishedArticles,
  toTagSlug,
} from "../../lib/content";
import { getConfigurationCollection } from "../../lib/utils";

export async function getStaticPaths() {
  const tags = await getArticleTags();
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

const { tag } = Astro.props;
const articles = (await getPublishedArticles()).filter((article) =>
  article.data.tags.some((articleTag) => toTagSlug(articleTag) === tag.slug),
);
const { data: config } = await getConfigurationCollection();
---

<Layout>
  <Fragment slot="head">
    <SEO
      title={`#${tag.name} — ${config.personal.name}`}
      description={`浏览标签“${tag.name}”下的文章。`}
      canonicalPath={`/tags/${tag.slug}`}
      tags={[tag.name]}
    />
  </Fragment>
  <Section class="pb-16">
    <PageHeader
      title={`#${tag.name}`}
      description={`共 ${articles.length} 篇文章`}
    />
    <div class="py-6">
      <Anchor url="/tags">查看全部标签</Anchor>
    </div>
    <ol class="divide-y-2 divide-zag-dark dark:divide-zag-light">
      {
        articles.map((article) => (
          <li class="py-8">
            <ArticleSnippet
              title={article.data.title}
              description={article.data.description}
              duration={article.data.readTime}
              url={`/blog/${article.data.slug}`}
              timestamp={article.data.timestamp}
              tags={article.data.tags}
              draft={article.data.draft}
            />
          </li>
        ))
      }
    </ol>
  </Section>
</Layout>
