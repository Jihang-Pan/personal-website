---
import SEO from "../../components/SEO.astro";
import Anchor from "../../components/common/Anchor.astro";
import PageHeader from "../../components/common/PageHeader.astro";
import Section from "../../components/common/Section.astro";
import Layout from "../../layouts/Layout.astro";
import { getArticleTags } from "../../lib/content";
import { getConfigurationCollection } from "../../lib/utils";

const tags = await getArticleTags();
const { data: config } = await getConfigurationCollection();
---

<Layout>
  <Fragment slot="head">
    <SEO
      title={config.tagMeta.title}
      description={config.tagMeta.description}
      canonicalPath="/tags"
    />
  </Fragment>
  <Section class="pb-16">
    <PageHeader
      title={config.texts.tagsName}
      description={config.tagMeta.description}
    />
    {
      tags.length > 0 ? (
        <ul class="grid gap-4 py-10 sm:grid-cols-2">
          {tags.map((tag) => (
            <li>
              <Anchor
                url={`/tags/${tag.slug}`}
                class="tag-directory flex min-h-14 justify-between px-4 py-3 no-underline"
              >
                <span>#{tag.name}</span>
                <span class="zag-muted tabular-nums">{tag.count}</span>
              </Anchor>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty-state my-10" role="status">
          <p class="font-display text-sm leading-loose">NO TAGS YET</p>
          <p class="mt-4 text-lg">发布文章后，标签会自动出现在这里。</p>
        </div>
      )
    }
  </Section>
</Layout>
