---
import SEO from "../components/SEO.astro";
import Prose from "../components/Prose.astro";
import Anchor from "../components/common/Anchor.astro";
import Section from "../components/common/Section.astro";
import TagList from "../components/common/TagList.astro";
import type { ProjectFrontmatter } from "../lib/types";
import { getConfigurationCollection, processArticleDate } from "../lib/utils";
import Layout from "./Layout.astro";

type Props = { frontmatter: ProjectFrontmatter };

const { frontmatter } = Astro.props;
const { data: config } = await getConfigurationCollection();
---

<Layout>
  <Fragment slot="head">
    <SEO
      title={`${frontmatter.title} — ${config.personal.name}`}
      description={frontmatter.longDescription ?? frontmatter.description}
      canonicalPath={`/projects/${frontmatter.slug}`}
      image={frontmatter.cardImage}
      tags={frontmatter.tags}
    />
    {frontmatter.draft && <meta name="robots" content="noindex, nofollow" />}
  </Fragment>
  <article>
    <Section class="pt-8 pb-16 sm:pt-12">
      <Anchor url="/projects" class="text-sm">← 返回项目列表</Anchor>
      <header class="zag-border-b zag-transition mt-8 pb-8 sm:mt-10 sm:pb-10">
        {frontmatter.draft && <p class="draft-badge mb-5 w-fit">草稿预览</p>}
        <h1 class="article-title font-display text-2xl leading-relaxed sm:text-4xl sm:leading-relaxed">
          {frontmatter.title}
        </h1>
        <p class="mt-5 text-lg leading-8 zag-muted">{frontmatter.description}</p>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm zag-muted">
          <time datetime={frontmatter.timestamp.toISOString()}>
            {processArticleDate(frontmatter.timestamp, config.site.locale)}
          </time>
          {
            frontmatter.updatedAt && (
              <span>
                {config.texts.updatedAt}{" "}
                {processArticleDate(frontmatter.updatedAt, config.site.locale)}
              </span>
            )
          }
        </div>
        <div class="mt-5">
          <TagList tags={frontmatter.tags} linked={false} label="项目标签" />
        </div>
        {
          (frontmatter.githubUrl || frontmatter.liveDemoUrl) && (
            <div class="mt-6 flex flex-wrap gap-5">
              {frontmatter.githubUrl && (
                <Anchor url={frontmatter.githubUrl} external>
                  查看 GitHub
                </Anchor>
              )}
              {frontmatter.liveDemoUrl && (
                <Anchor url={frontmatter.liveDemoUrl} external>
                  打开演示
                </Anchor>
              )}
            </div>
          )
        }
      </header>
      <Prose class="py-10 sm:py-14">
        <slot />
      </Prose>
    </Section>
  </article>
</Layout>
